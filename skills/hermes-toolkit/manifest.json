{
  "id": "hermes-toolkit",
  "name": "Hermes Agent Memory & Toolkit",
  "description": "Auto-injects Hermes persistent memories into chat and auto-syncs learned facts back to Hermes Agent.",
  "version": "1.0.0",
  "category": "prompt-injection",
  "hook": "system-prompt",
  "default_enabled": true,
  "source": "custom",
  "config_schema": [
    {
      "key": "auto_save_memory",
      "label": "Auto-Save Learned Context",
      "type": "boolean",
      "default": true
    },
    {
      "key": "extraction_mode",
      "label": "Extraction Mode (LLM vs Rule-based)",
      "type": "select",
      "options": [
        "rule_based",
        "llm"
      ],
      "default": "rule_based"
    },
    {
      "key": "extraction_model",
      "label": "Memory Extraction Model",
      "type": "string",
      "default": "gpt-4o-mini"
    },
    {
      "key": "extraction_cooldown_seconds",
      "label": "Extraction Cooldown (seconds)",
      "type": "slider",
      "min": 10,
      "max": 300,
      "step": 10,
      "default": 60
    },
    {
      "key": "char_limit",
      "label": "Memory Character Limit",
      "type": "slider",
      "min": 500,
      "max": 5000,
      "step": 100,
      "default": 2200
    }
  ]
}