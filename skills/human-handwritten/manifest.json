{
  "id": "human-handwritten",
  "name": "Human Handwritten & Anti-Slop",
  "description": "Enforces natural human phrasing, zero AI slop, no robotic transition cliches, clean code without useless comments, and verified functional solutions.",
  "version": "1.0.0",
  "category": "prompt-injection",
  "hook": "system-prompt",
  "default_enabled": true,
  "source": "custom",
  "config_schema": [
    {
      "key": "strictness",
      "label": "Anti-Slop Strictness",
      "type": "slider",
      "min": 1,
      "max": 10,
      "default": 10
    },
    {
      "key": "routing_mode",
      "type": "enum",
      "label": "Activation Mode",
      "options": [
        {
          "value": "smart",
          "label": "Smart (topic-aware)",
          "desc": "Inject only when message is about human writing/anti-slop"
        },
        {
          "value": "always",
          "label": "Always Active",
          "desc": "Inject on every request"
        }
      ],
      "default": "always"
    }
  ],
  "routable": true,
  "routing_threshold": 0.35,
  "triggers": [
    "anti slop",
    "human handwritten",
    "clean code comments",
    "no ai cliches",
    "natural phrasing",
    "remove filler phrases"
  ],
  "keywords": [
    "slop",
    "handwritten",
    "phrasing",
    "cliches",
    "comments",
    "natural",
    "human",
    "clean"
  ]
}
